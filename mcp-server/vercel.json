{
  "version": 2,
  "functions": {"api/mcp.js": {"maxDuration": 120}},
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?endpoint=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/oauth?endpoint=resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?endpoint=discovery"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api/oauth?endpoint=authorize"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/oauth?endpoint=token"
    },
    {
      "source": "/oauth/register",
      "destination": "/api/oauth?endpoint=register"
    }
  ],
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "10 17 * * *"
    }
  ]
}
